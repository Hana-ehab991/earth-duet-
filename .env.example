# ---- Backend (copy to backend/.env or export in your shell) ----
# Serve clearly-labelled SYNTHETIC demo data from data/demo when real data has not been fetched. Never enable in production.
EARTH_DUET_DEMO_MODE=false
# Comma-separated allowed browser origins for CORS (your deployed frontend URL in production)
EARTH_DUET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: override the data directory
# EARTH_DUET_DATA_DIR=/absolute/path/to/data

# ---- Data scripts only (never needed by the API server) ----
# Google Earth Engine project, only for `fetch_projections.py --backend ee` (after `earthengine authenticate`)
# EE_PROJECT=your-gcp-project-id

# ---- Frontend (frontend/.env.local) ----
# Base URL of the deployed API. Leave unset in dev (Vite proxies /api to http://127.0.0.1:8000).
# VITE_API_BASE_URL=https://your-api.example.com
# Optional Cesium ion token (higher-res world imagery/terrain). Public by nature: use a URL-restricted token. Not required.
# VITE_CESIUM_ION_TOKEN=
# NOTE: NASA POWER, GIBS and the NEX-GDDP-CMIP6 S3 bucket need NO API key.

# ---- Location comparison (Earth Engine, server-side only; see docs/EARTH_ENGINE_COMPARISON.md) ----
# Google Cloud project that is REGISTERED for Earth Engine and has the Earth Engine API enabled.
# (Same variable the data scripts already use. GOOGLE_CLOUD_PROJECT is accepted as a fallback.)
# EE_PROJECT=your-gcp-project-id
# Credentials: use Application Default Credentials / an attached service identity. NEVER put keys or tokens here.
#   local development:  earthengine authenticate   (or: gcloud auth application-default login --scopes=https://www.googleapis.com/auth/earthengine,https://www.googleapis.com/auth/cloud-platform)
#   deployment:         attach a service account to Cloud Run / Compute Engine / GKE (no key file)
# Request protection (defaults shown; values are clamped to safe bounds)
# EARTH_DUET_EE_TIMEOUT_S=60          # max wait for one Earth Engine computation
# EARTH_DUET_EE_MAX_CONCURRENT=4      # max computations in flight
# EARTH_DUET_EE_QUEUE_WAIT_S=10       # max wait for a free slot before answering "busy"

# ---- Location comparison API + cache (Phase 3; defaults shown, values are clamped to safe bounds) ----
# EARTH_DUET_COMPARISON_CACHE_PATH=            # default: <data dir>/cache/comparison.sqlite
# EARTH_DUET_COMPARISON_CACHE_TTL_DAYS=30      # 0 disables the cache
# EARTH_DUET_COMPARISON_DEADLINE_S=120         # overall time limit per request
# EARTH_DUET_COMPARISON_RATE_LIMIT=20          # per client per window; 0 disables. PER PROCESS (see docs)
# EARTH_DUET_COMPARISON_RATE_WINDOW_S=60
# EARTH_DUET_TRUST_FORWARDED_FOR=false         # true ONLY behind a trusted reverse proxy
# EARTH_DUET_COMPARISON_MAX_BODY_BYTES=8192
